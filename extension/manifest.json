{
  "manifest_version": 3,
  "name": "WeryAI Image Compressor",
  "short_name": "Image Compressor",
  "version": "1.1.0",
  "description": "Compress JPG, PNG and WebP locally in batches. Optionally send a right-clicked image to WeryAI's AI photo editor.",
  "homepage_url": "https://www.wery.ai/?utm_source=chrome_extension",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Open Image Compressor",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "host_permissions": [
    "https://www.wery.ai/*"
  ]
}
